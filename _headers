#
# YANG DIUBAH DARI v1.3:
#
#   1. Global CSP (/*):
#      + connect-src: ditambahkan https://api.clickup.com (ATS API)
#      + frame-src: ditambahkan 'self' https://forms.clickup.com
#        (izin render iframe formulir lamaran ClickUp di modal)
#      + font-src: ditambahkan data:
#   2. Penambahan blok /MFB/Talent/*:
#      + Service Worker: max-age=0, must-revalidate
#      + Manifest PWA: Content-Type application/manifest+json
#      + Halaman HTML (career.html, index.html, mockups): max-age=0
#      + Aset statis (/MFB/Talent/assets/*): immutable 1 tahun
#
# TIDAK ADA SATUPUN aturan Anabhi Smart Play atau Microsoft auth
# yang dihapus. Seluruhnya tetap utuh dan kompatibel 100%.
# ================================================================

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' blob: https://alcdn.msauth.net https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://login.microsoftonline.com https://graph.microsoft.com https://*.msauth.net https://*.msftauth.net https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://cloudflareinsights.com https://script.google.com https://script.googleusercontent.com https://remoteok.com https://www.arbeitnow.com https://generativelanguage.googleapis.com https://fonts.googleapis.com https://api.clickup.com https://*.supabase.co; frame-src 'self' https://forms.clickup.com https://calendar.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# ════════════════════════════════════════════════════════════════
# ANABHI SMART PLAY — /Anabhi-Smart-Play/
# ════════════════════════════════════════════════════════════════
#
# Ditaruh SETELAH aturan umum dengan sengaja. Cloudflare menerapkan
# semua aturan yang cocok, dan untuk nama header yang sama aturan
# yang BELAKANGAN menang. Jadi blok ini menimpa `/*.png` dkk hanya
# pada berkas yang memang tidak boleh di-cache.

# ── Service Worker: JANGAN PERNAH di-cache ──────────────────────
# sw.js yang ter-cache = pengguna terkunci di versi lama selamanya,
# dan tidak bisa diperbaiki dari jarak jauh selain meminta mereka
# membersihkan data aplikasi satu per satu.
/Anabhi-Smart-Play/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/javascript; charset=utf-8

# ── Manifest: Content-Type wajib eksplisit ──────────────────────
# Default Cloudflare mengirim application/json — itu keliru untuk
# manifest dan bisa membuat install PWA gagal.
/Anabhi-Smart-Play/manifest.json
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# ── Halaman utama: selalu revalidate ────────────────────────────
/Anabhi-Smart-Play/
  Cache-Control: public, max-age=0, must-revalidate

/Anabhi-Smart-Play/index.html
  Cache-Control: public, max-age=0, must-revalidate

# ── Aset statis ─────────────────────────────────────────────────
# Aman immutable: berkas js & css selalu diminta dengan ?v=... , dan
# query string membuat URL-nya berbeda setiap kali versi dinaikkan.
/Anabhi-Smart-Play/assets/*
  Cache-Control: public, max-age=31536000, immutable

/Anabhi-Smart-Play/js/*
  Cache-Control: public, max-age=31536000, immutable

/Anabhi-Smart-Play/css/*
  Cache-Control: public, max-age=31536000, immutable

# ── Font: butuh CORS walau satu domain (permintaan font selalu CORS) ──
/Anabhi-Smart-Play/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

