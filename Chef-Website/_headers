# Cloudflare Pages headers
# Development · Anabhi Dev
# Version   : 1.1
# Generated : 28 August 2026, 03:12:30
# ----------------------------------------------------------------
# Cloudflare memproses file ini dari atas ke bawah; aturan path yang
# lebih spesifik ditaruh SETELAH aturan umum.
# ================================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://images.unsplash.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'

# Aset ber-version-query aman di-cache lama: URL-nya berubah setiap
# kali isinya berubah.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML tidak boleh immutable — kalau tidak, perubahan konten tidak
# pernah sampai ke pengunjung lama tanpa hard refresh.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
