# File ini dibaca otomatis oleh Cloudflare Pages saat deploy.
# Taruh di ROOT project (sejajar dengan index.html), bukan di
# dalam folder css/ atau js/.
#
# 🔴 Baris frame-src di bawah yang memperbaiki peta Google Maps
# yang tampil "This content is blocked" di preview.
# ================================================================

# --- Semua halaman: izinkan iframe Google Maps ---
/*
  Content-Security-Policy: frame-src 'self' https://www.google.com https://maps.google.com https://maps.googleapis.com;
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# --- Cache panjang untuk aset statis (CSS, JS) ---
# Aman karena nama file tetap sama; kalau isi berubah, Cloudflare
# otomatis invalidate cache berdasarkan hash deploy.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# --- Cache sedang untuk gambar lokal (favicon, OG image) ---
/assets/*
  Cache-Control: public, max-age=604800

# --- robots.txt & sitemap.xml: selalu fetch ulang, jangan di-cache lama ---
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
