# ================================================================
# Miss Fish Bali - Career Platform .gitignore
# ================================================================

# OS System Files
Thumbs.db
Desktop.ini
.DS_Store

# Environment Secrets & Credentials (NEVER commit secrets)
.env
.env.*
!.env.example

# Node / Dependencies / Logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Build & Wrangler Temp
.wrangler/
.mf/

# Assistant / Workspace Temp
.gemini/
.system_generated/
scratch/
.vscode/
.idea/
